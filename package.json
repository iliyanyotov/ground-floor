{
  "name": "ground-floor",
  "version": "0.1.0",
  "private": false,
  "description": "Baseline dotfiles and configs for any TypeScript project",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:ci": "biome ci --error-on-warnings .",
    "preinstall": "bun scripts/check-bun-version.ts",
    "prepare": "husky",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "release": "commit-and-tag-version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/bun": "1.4.4",
    "commit-and-tag-version": "13.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "typescript": "6.0.3"
  }
}
