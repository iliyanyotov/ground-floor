{
  "name": "ground-floor",
  "version": "0.1.0",
  "private": false,
  "description": "Baseline dotfiles and configs for any TypeScript project",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:ci": "biome ci .",
    "preinstall": "bun scripts/check-bun-version.ts",
    "prepare": "husky",
    "format": "biome format --write .",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "release": "commit-and-tag-version"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@types/bun": "1.3.13",
    "commit-and-tag-version": "12.7.3",
    "husky": "9.1.7",
    "lint-staged": "17.0.7",
    "typescript": "6.0.3"
  }
}
