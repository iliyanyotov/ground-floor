#!/usr/bin/env sh
set -eu

# $1 = previous HEAD, $2 = new HEAD, $3 = 1 for a branch checkout, 0 for a file
[ "$3" = "1" ] || exit 0

if [ -n "$(git diff --name-only "$1" "$2" -- package.json bun.lock)" ]; then
  echo "Dependencies changed - running bun install..."
  bun install --frozen-lockfile
fi
